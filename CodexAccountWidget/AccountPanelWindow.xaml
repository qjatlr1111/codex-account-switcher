<Window x:Class="CodexAccountWidget.AccountPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexAccountWidget.Controls"
        Title="Codex 계정 목록"
        Width="372" MaxHeight="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccountHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#228FD8FF" Offset="0"/>
            <GradientStop Color="#109B7BFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- 패널 헤더 아래를 훑고 지나가는 스캔 라인 -->
        <Storyboard x:Key="ShimmerStoryboard">
            <DoubleAnimation Storyboard.TargetName="ShimmerShift" Storyboard.TargetProperty="X"
                             From="-1" To="1" Duration="0:0:2.4" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeaderPrompt" Storyboard.TargetProperty="CursorOpacity"
                                           Duration="0:0:1" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- 전환 중 연출: 궤도 링, 공전하는 혜성, 깜빡이는 프롬프트, 타이핑 점 -->
        <Storyboard x:Key="SwitchingStoryboard">
            <DoubleAnimation Storyboard.TargetName="OrbitOuterRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.6" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="OrbitInnerRotate" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:2.4" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="CometRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchPrompt" Storyboard.TargetProperty="CursorOpacity"
                                           RepeatBehavior="Forever" Duration="0:0:0.8">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SwitchPrompt" Storyboard.TargetProperty="ChevronOffset"
                                           RepeatBehavior="Forever" Duration="0:0:1.6">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="4"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="SwitchGlow" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TypingDot1" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="TypingDot2" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"
                             BeginTime="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="TypingDot3" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"
                             BeginTime="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="RefreshSpinStoryboard">
            <DoubleAnimation Storyboard.TargetName="RefreshRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 카드 공통: 활성 카드는 네온 테두리 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#148FB4FF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#1A5B8CFF"/>
                    <Setter Property="BorderBrush" Value="#668FB4FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 활성 표시 막대 (네온 글로우) -->
        <Style x:Key="ActiveBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NeonGradientBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF5B8CFF" BlurRadius="10" ShadowDepth="0" Opacity="0.95"/>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="BareButton" TargetType="Button">
            <ContentPresenter HorizontalAlignment="Stretch"/>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="PanelSurface" Margin="8" Padding="12,12,12,10"
                Background="{StaticResource PanelBrush}" Opacity="0"
                BorderThickness="1" CornerRadius="14">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#884FD8FF" Offset="0"/>
                    <GradientStop Color="#225B8CFF" Offset="0.35"/>
                    <GradientStop Color="#14FFFFFF" Offset="0.7"/>
                    <GradientStop Color="#559B7BFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#FF03050A"/>
            </Border.Effect>

            <Grid>
                <!-- 좌상단 시안, 우하단 바이올렛 글로우 -->
                <Ellipse Width="230" Height="120" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-46,-54,0,0" Fill="{StaticResource CyanGlowBrush}" Opacity="0.4"
                         IsHitTestVisible="False"/>
                <Ellipse Width="220" Height="120" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-50,-56" IsHitTestVisible="False" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#559B7BFF" Offset="0"/>
                            <GradientStop Color="#009B7BFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid x:Name="NormalContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSwitching}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 헤더 -->
                    <Grid Margin="2,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                            <Rectangle Margin="-6" RadiusX="12" RadiusY="12" Fill="{StaticResource NeonGlowBrush}"/>
                            <Border CornerRadius="8" Background="#1A5B8CFF" BorderBrush="#558FB4FF" BorderThickness="1"/>
                            <controls:PromptGlyph x:Name="HeaderPrompt" Width="15" Height="15"
                                                  Fill="{StaticResource NeonGradientBrush}"/>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Codex 연결" FontSize="15.5" FontWeight="SemiBold"/>
                            <TextBlock Text="provider 또는 계정을 누르면 Codex가 다시 시작됩니다" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Width="32" Height="32" Padding="0"
                                Style="{StaticResource FlatButton}" ToolTip="사용량 새로고침"
                                Click="OnRefreshClicked">
                            <TextBlock Text="↻" FontSize="14" RenderTransformOrigin="0.5,0.55">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="RefreshRotate"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <!-- 스캔 라인 구분선 -->
                    <Grid Grid.Row="1" Height="1">
                        <Border Background="#1A8FB4FF"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="ShimmerShift"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#004FD8FF" Offset="0.25"/>
                                    <GradientStop Color="#FF4FD8FF" Offset="0.45"/>
                                    <GradientStop Color="#FF9B7BFF" Offset="0.55"/>
                                    <GradientStop Color="#009B7BFF" Offset="0.75"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="2" MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,10,0,8">
                        <StackPanel>
                            <!-- Model provider 목록 -->
                            <StackPanel Margin="0,0,0,6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Providers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="› MODEL PROVIDERS" Margin="6,0,6,6" FontSize="9.5"
                                           Style="{StaticResource MonoText}" Foreground="{StaticResource MutedBrush}"/>
                                <ItemsControl x:Name="ProviderList" ItemsSource="{Binding Providers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,0,6" Padding="0" HorizontalContentAlignment="Stretch"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    OverridesDefaultStyle="True" Template="{StaticResource BareButton}"
                                                    Click="OnProviderClicked">
                                                <Border Style="{StaticResource CardBorder}">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform/>
                                                    </Border.RenderTransform>
                                                    <Border.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ProviderHoverSurface"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="1" Duration="0:0:0.14"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                     To="-1.5" Duration="0:0:0.18">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ProviderHoverSurface"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0" Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                     To="0" Duration="0:0:0.22"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Border.Triggers>
                                                    <Grid>
                                                        <Border x:Name="ProviderHoverSurface" CornerRadius="10"
                                                                Background="{StaticResource AccountHoverBrush}" Opacity="0"
                                                                IsHitTestVisible="False"/>
                                                        <Grid Margin="10,9,12,9">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource ActiveBar}"/>
                                                            <StackPanel Grid.Column="2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                               FontWeight="SemiBold" MaxWidth="190"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border Margin="6,0,0,0" Style="{StaticResource PillBorder}"
                                                                            Background="{StaticResource AccentButtonBrush}" BorderBrush="Transparent"
                                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="사용 중" FontSize="9" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Id}" Margin="0,3,0,0" FontSize="9.5"
                                                                           Style="{StaticResource MonoText}"
                                                                           Foreground="{StaticResource MutedBrush}"
                                                                           MaxWidth="200" HorizontalAlignment="Left"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Style="{StaticResource PillBorder}">
                                                                <TextBlock Text="GATEWAY" FontSize="9" Style="{StaticResource MonoText}"
                                                                           Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="› CHATGPT ACCOUNTS" Margin="6,0,6,6" FontSize="9.5"
                                       Style="{StaticResource MonoText}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="등록된 계정이 없습니다" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,14" FontSize="10.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl x:Name="AccountList" ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,6" Padding="0" HorizontalContentAlignment="Stretch"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                OverridesDefaultStyle="True" Template="{StaticResource BareButton}"
                                                Click="OnAccountClicked"
                                                PreviewMouseRightButtonUp="OnAccountRightClicked">
                                            <Border Style="{StaticResource CardBorder}">
                                                <Border.RenderTransform>
                                                    <TranslateTransform/>
                                                </Border.RenderTransform>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="AccountHoverSurface"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.14"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                 To="-1.5" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="AccountHoverSurface"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                 To="0" Duration="0:0:0.22"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>

                                                <Grid>
                                                    <Border x:Name="AccountHoverSurface" CornerRadius="10"
                                                            Background="{StaticResource AccountHoverBrush}" Opacity="0"
                                                            IsHitTestVisible="False"/>
                                                    <Grid Margin="10,9,12,9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Style="{StaticResource ActiveBar}"/>

                                                        <StackPanel Grid.Column="2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Email}" FontSize="12" FontWeight="SemiBold"
                                                                           MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                                                <Border Grid.Column="1" Margin="6,0,0,0" HorizontalAlignment="Left"
                                                                        Style="{StaticResource PillBorder}"
                                                                        Background="{StaticResource AccentButtonBrush}" BorderBrush="Transparent"
                                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="사용 중" FontSize="9" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Border Grid.Column="2">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource PillBorder}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PlanLabel}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding PlanLabel}" FontSize="9" Style="{StaticResource MonoText}"
                                                                               Foreground="{StaticResource AccentBrush}"/>
                                                                </Border>
                                                            </Grid>

                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="40"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="5"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Text="{Binding PrimaryLabel}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <controls:UsageBar Grid.Column="1" Height="5" VerticalAlignment="Center"
                                                                                   Target="{Binding PrimaryGauge}"
                                                                                   TrackBrush="#228FB4FF"
                                                                                   FillBrush="{StaticResource BarGradientBrush}"
                                                                                   LowBrush="{StaticResource LowGradientBrush}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding PrimaryPercentText}" FontSize="10.5"
                                                                           Style="{StaticResource MonoText}"
                                                                           FontWeight="SemiBold" HorizontalAlignment="Right"/>

                                                                <TextBlock Grid.Row="2" Text="{Binding SecondaryLabel}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <controls:UsageBar Grid.Row="2" Grid.Column="1" Height="5" VerticalAlignment="Center"
                                                                                   Target="{Binding SecondaryGauge}"
                                                                                   TrackBrush="#228FB4FF"
                                                                                   FillBrush="{StaticResource BarGradientBrush}"
                                                                                   LowBrush="{StaticResource LowGradientBrush}"/>
                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SecondaryPercentText}" FontSize="10.5"
                                                                           Style="{StaticResource MonoText}"
                                                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                                            </Grid>

                                                            <TextBlock Margin="0,7,0,0" Text="{Binding Status}" FontSize="9.5"
                                                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="3">
                        <Button Content="＋  계정 추가" Height="36" Click="OnAddClicked">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoginPending}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="로그인 취소" Height="36" Foreground="{StaticResource DangerTextBrush}"
                                Click="OnCancelLoginClicked">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoginPending}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="{Binding Message}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center" Margin="4,9,4,1" TextWrapping="Wrap"/>
                </Grid>

                <!-- 전환 진행 화면 -->
                <Grid x:Name="SwitchingContent" MinHeight="236" Margin="6">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSwitching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse x:Name="SwitchGlow" Margin="-18" Fill="{StaticResource NeonGlowBrush}"/>
                            <Ellipse Stroke="#1E8FB4FF" StrokeThickness="2"/>
                            <Ellipse Stroke="{StaticResource NeonGradientBrush}" StrokeThickness="2.5"
                                     StrokeDashArray="5,3.2" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="OrbitOuterRotate"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Margin="13" Stroke="#889B7BFF" StrokeThickness="1.4"
                                     StrokeDashArray="1,3" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="OrbitInnerRotate"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- 공전하는 혜성 -->
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="CometRotate"/>
                                </Grid.RenderTransform>
                                <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,-3,0,0" Fill="White">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FF4FD8FF" BlurRadius="14" ShadowDepth="0" Opacity="1"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <controls:PromptGlyph x:Name="SwitchPrompt" Width="30" Height="30"
                                                  Fill="{StaticResource NeonGradientBrush}"/>
                        </Grid>

                        <TextBlock Text="Codex 연결을 변경하고 있습니다" FontSize="14.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBlock Text="{Binding SwitchingProfile.Email, TargetNullValue=선택한 계정}"
                                   FontSize="11" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="290">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SwitchingProvider}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SwitchingProvider.DisplayName}"
                                   FontSize="11" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="290">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SwitchingProvider}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 타이핑 중 점 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,10">
                            <Ellipse x:Name="TypingDot1" Width="7" Height="7" Margin="4,0" Fill="#FF4FD8FF"/>
                            <Ellipse x:Name="TypingDot2" Width="7" Height="7" Margin="4,0" Fill="#FF5B8CFF"/>
                            <Ellipse x:Name="TypingDot3" Width="7" Height="7" Margin="4,0" Fill="#FF9B7BFF"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Message}" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="완료될 때까지 위젯을 종료하지 마세요"
                                   FontSize="9.5" Foreground="#66FFFFFF"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Popup x:Name="AccountMenuPopup"
               Placement="MousePoint"
               AllowsTransparency="True" StaysOpen="False"
               Opened="OnAccountMenuOpened">
            <Border x:Name="AccountMenuSurface" Width="178" Margin="6" Padding="7"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#448FB4FF" BorderThickness="1" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#FF03050A"/>
                </Border.Effect>
                <Button Content="이 계정 제거" Height="34"
                        Foreground="{StaticResource DangerTextBrush}" Style="{StaticResource FlatButton}"
                        Click="OnRemoveClicked"/>
            </Border>
        </Popup>
    </Grid>
</Window>
