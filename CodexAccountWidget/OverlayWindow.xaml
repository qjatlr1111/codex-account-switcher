<Window x:Class="CodexAccountWidget.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexAccountWidget.Controls"
        Title="Codex 계정 위젯"
        Width="226" Height="44"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <SolidColorBrush x:Key="WidgetPrimaryTextBrush" Color="#FFF5F7FF"/>
        <SolidColorBrush x:Key="WidgetSecondaryTextBrush" Color="#FFA7A7A7"/>
        <SolidColorBrush x:Key="WidgetAccentTextBrush" Color="#FFD8E4FF"/>
        <LinearGradientBrush x:Key="WidgetHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2E8FD8FF" Offset="0"/>
            <GradientStop Color="#1CFFFFFF" Offset="0.5"/>
            <GradientStop Color="#1A9B7BFF" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WidgetPrimaryTextBrush}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="RootBorder" Background="#01000000"
                BorderThickness="0" CornerRadius="9"
                Cursor="Hand" MouseLeftButtonUp="OnOverlayClicked"
                MouseRightButtonUp="OnOverlayRightClicked">
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- 꺾쇠가 앞으로 튕겨 나갔다 돌아옵니다 -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Prompt" Storyboard.TargetProperty="ChevronOffset">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="0.12">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="4"/>
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="PromptScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.14" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PromptScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.14" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                             To="0.95" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="GaugeSpin" Storyboard.TargetProperty="Angle"
                                             By="360" Duration="0:0:0.7">
                                <DoubleAnimation.EasingFunction>
                                    <QuarticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                    <!-- 마우스가 올라가 있는 동안만 커서가 깜빡입니다 -->
                    <BeginStoryboard x:Name="CursorBlink">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Prompt" Storyboard.TargetProperty="CursorOpacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <StopStoryboard BeginStoryboardName="CursorBlink"/>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PromptScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="PromptScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Border x:Name="HoverSurface" Background="{StaticResource WidgetHoverBrush}"
                        BorderBrush="#228FB4FF" BorderThickness="1"
                        CornerRadius="9" Opacity="0" IsHitTestVisible="False"/>

                <Grid Margin="8,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 링 게이지 + 터미널 프롬프트 아이콘 -->
                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <Ellipse x:Name="HoverGlow" Margin="-6" Fill="{StaticResource NeonGlowBrush}"
                                 Opacity="0" IsHitTestVisible="False"/>
                        <!-- 잔여량이 적으면 붉은 경고 글로우가 숨 쉬듯 깜빡입니다 -->
                        <Ellipse Margin="-7" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#77FF6B7A" Offset="0"/>
                                    <GradientStop Color="#00FF6B7A" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile.IsLow}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="LowPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.15" To="1" Duration="0:0:1.1">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="LowPulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <controls:ArcGauge Target="{Binding ActiveProfile.PrimaryGauge, FallbackValue=-1, TargetNullValue=-1}"
                                           StrokeThickness="2.6" GlowOpacity="0.34"
                                           TrackBrush="#2E8FB4FF"
                                           FillBrush="{StaticResource NeonGradientBrush}"
                                           LowBrush="{StaticResource LowGradientBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                            <controls:ArcGauge.RenderTransform>
                                <RotateTransform x:Name="GaugeSpin"/>
                            </controls:ArcGauge.RenderTransform>
                        </controls:ArcGauge>
                        <controls:PromptGlyph x:Name="Prompt" Width="14" Height="14"
                                              Fill="{StaticResource NeonGradientBrush}"
                                              RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <controls:PromptGlyph.RenderTransform>
                                <ScaleTransform x:Name="PromptScale"/>
                            </controls:PromptGlyph.RenderTransform>
                        </controls:PromptGlyph>
                    </Grid>

                    <!-- ChatGPT 계정 연결 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveProfile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ActiveProfile.Email, TargetNullValue=Codex 계정}" FontSize="11.5"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ActiveProfile.PlanLabel}" FontSize="9.5"
                                   Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource WidgetSecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveProfile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ActiveProfile.PrimaryText, TargetNullValue=사용량 --}" FontSize="10.5"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding ActiveProfile.SecondaryText}" FontSize="9.5"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource WidgetSecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- Model provider 연결 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveProvider}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ActiveProvider.DisplayName}" FontSize="11.5"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="MODEL PROVIDER" FontSize="9.5" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource WidgetSecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveProvider}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="게이트웨이" FontSize="10.5" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource WidgetAccentTextBrush}"/>
                        <TextBlock Text="{Binding ActiveProvider.Id}" FontSize="9.5" Style="{StaticResource MonoText}"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource WidgetSecondaryTextBrush}"
                                   MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
