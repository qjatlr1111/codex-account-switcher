<Window x:Class="CodexAccountWidget.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 계정 위젯"
        Width="218" Height="44"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <SolidColorBrush x:Key="WidgetPrimaryTextBrush" Color="#FFF5F7FF"/>
        <SolidColorBrush x:Key="WidgetSecondaryTextBrush" Color="#FFA7A7A7"/>
        <SolidColorBrush x:Key="WidgetAccentTextBrush" Color="#FFD8E4FF"/>
        <LinearGradientBrush x:Key="WidgetHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#30FFFFFF" Offset="0"/>
            <GradientStop Color="#20FFFFFF" Offset="0.48"/>
            <GradientStop Color="#16FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WidgetPrimaryTextBrush}"/>
        </Style>
    </Window.Resources>
    <Grid>

        <Border x:Name="RootBorder" Background="#01000000"
                BorderThickness="0" CornerRadius="9"
                Cursor="Hand" MouseLeftButtonUp="OnOverlayClicked"
                MouseRightButtonUp="OnOverlayRightClicked">
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Border x:Name="HoverSurface" Background="{StaticResource WidgetHoverBrush}"
                        CornerRadius="9" Opacity="0" IsHitTestVisible="False"/>

            <Grid Margin="11,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="9"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="24" Height="24" CornerRadius="6" Background="Transparent" VerticalAlignment="Center">
                    <TextBlock Text="C" FontWeight="SemiBold" Foreground="{DynamicResource WidgetAccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveProfile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding ActiveProfile.Email, TargetNullValue=Codex 계정}" FontSize="11.5"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ActiveProfile.PlanLabel}" FontSize="9.5" Foreground="{DynamicResource WidgetSecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveProvider}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding ActiveProvider.DisplayName}" FontSize="11.5"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="MODEL PROVIDER" FontSize="9.5" Foreground="{DynamicResource WidgetSecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveProfile}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding ActiveProfile.PrimaryText, TargetNullValue=사용량 --}" FontSize="10.5"
                               HorizontalAlignment="Right" Foreground="{DynamicResource WidgetPrimaryTextBrush}"/>
                    <TextBlock Text="{Binding ActiveProfile.SecondaryText}" FontSize="9.5"
                               HorizontalAlignment="Right" Foreground="{DynamicResource WidgetSecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveProvider}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="게이트웨이" FontSize="10.5"
                               HorizontalAlignment="Right" Foreground="{DynamicResource WidgetPrimaryTextBrush}"/>
                    <TextBlock Text="{Binding ActiveProvider.Id}" FontSize="9.5"
                               HorizontalAlignment="Right" Foreground="{DynamicResource WidgetSecondaryTextBrush}"
                               MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
