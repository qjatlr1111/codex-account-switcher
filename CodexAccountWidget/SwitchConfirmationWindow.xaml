<Window x:Class="CodexAccountWidget.SwitchConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="계정 변경 확인"
        Width="330" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Opacity="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale">
    <Border Margin="8" Padding="18" CornerRadius="14"
            Background="{StaticResource PanelBrush}" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#884FD8FF" Offset="0"/>
                <GradientStop Color="#225B8CFF" Offset="0.4"/>
                <GradientStop Color="#559B7BFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#FF03050A"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Codex 계정을 변경할까요?" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Codex가 종료된 뒤 선택한 계정으로 다시 실행됩니다."
                       Margin="0,5,0,14" FontSize="10.5"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

            <Border Padding="12,10" CornerRadius="9" Background="#145B8CFF" BorderBrush="#2E8FB4FF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="변경할 계정" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding Email}" Margin="0,3,0,0"
                               FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding PrimaryText}" FontSize="10.5"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding SecondaryText}" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="취소" Height="36" Style="{StaticResource FlatButton}"
                        IsCancel="True"
                        Click="OnCancelClicked"/>
                <Button Grid.Column="2" Content="이 계정으로 변경" Height="36"
                        Style="{StaticResource AccentButton}" IsDefault="True"
                        Click="OnConfirmClicked"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
