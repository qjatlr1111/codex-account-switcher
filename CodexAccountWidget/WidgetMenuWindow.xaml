<Window x:Class="CodexAccountWidget.WidgetMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="위젯 메뉴"
        Width="218" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale"
        Deactivated="OnDeactivated">
    <Border Margin="6" Padding="7"
            Background="{StaticResource PanelBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#884FD8FF" Offset="0"/>
                <GradientStop Color="#225B8CFF" Offset="0.4"/>
                <GradientStop Color="#559B7BFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.55" Color="#FF03050A"/>
        </Border.Effect>
        <StackPanel>
            <CheckBox x:Name="AutoContrastCheckBox"
                      Content="배경에 맞춰 글자색 자동 조절"
                      Height="34" Padding="8,0" Margin="2,0,2,5"
                      Foreground="White" Cursor="Hand"
                      Click="OnAutoContrastClicked"/>
            <Button Content="위젯 숨기기" Height="34" Margin="0,0,0,5"
                    Style="{StaticResource FlatButton}" Click="OnHideClicked"/>
            <Button Content="프로그램 끝내기" Height="34"
                    Foreground="{StaticResource DangerTextBrush}" Style="{StaticResource FlatButton}"
                    Click="OnExitClicked"/>
        </StackPanel>
    </Border>
</Window>
