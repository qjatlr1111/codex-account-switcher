<Window x:Class="CodexAccountWidget.WidgetMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="위젯 메뉴"
        Width="218" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        Deactivated="OnDeactivated">
    <Border Margin="6" Padding="7"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#3AFFFFFF" BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel>
            <Button Content="위젯 숨기기" Height="34" Margin="0,0,0,5"
                    Style="{StaticResource FlatButton}" Click="OnHideClicked"/>
            <Button Content="프로그램 끝내기" Height="34"
                    Foreground="#FFFFB4AB" Style="{StaticResource FlatButton}"
                    Click="OnExitClicked"/>
        </StackPanel>
    </Border>
</Window>
