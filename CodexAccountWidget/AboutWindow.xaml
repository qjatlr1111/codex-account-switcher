<Window x:Class="CodexAccountWidget.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 계정 전환 위젯 정보"
        Width="390" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Opacity="0">
    <Border Margin="8" Padding="20" CornerRadius="12" Background="#F41F1F1F">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Codex 계정 전환 위젯" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,4,0,14" FontSize="10.5"
                       Foreground="{StaticResource MutedBrush}"/>

            <TextBlock Text="작업 표시줄에서 Codex 계정과 사용량을 확인하고, 등록한 계정으로 전환하는 Windows 위젯입니다."
                       FontSize="11" TextWrapping="Wrap" LineHeight="17"/>

            <Border Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="#20FFFFFF">
                <StackPanel>
                    <TextBlock Text="보안 안내" FontSize="10.5" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap" LineHeight="15"
                               Foreground="{StaticResource MutedBrush}"
                               Text="OpenAI의 공식 제품이 아닌 커뮤니티 도구입니다. 계정별 인증 캐시는 로컬 디스크에 저장되므로 공유 PC에서는 사용하지 마세요."/>
                </StackPanel>
            </Border>

            <Button Content="GitHub 저장소 열기" Height="35" Margin="0,16,0,0"
                    Style="{StaticResource FlatButton}" Click="OnGitHubClicked"/>
            <Button Content="닫기" Height="35" Margin="0,8,0,0"
                    Background="#FF4169A8" BorderBrush="Transparent"
                    Style="{StaticResource FlatButton}" Click="OnCloseClicked"/>
        </StackPanel>
    </Border>
</Window>
