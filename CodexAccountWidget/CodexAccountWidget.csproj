<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CodexAccountSwitcher</AssemblyName>
    <RootNamespace>CodexAccountWidget</RootNamespace>
    <Version>1.1.6</Version>
    <AssemblyTitle>Codex Account Switcher</AssemblyTitle>
    <Product>Codex Account Switcher</Product>
    <Description>작업 표시줄에서 Codex 계정과 사용량을 확인하고 전환하는 Windows 위젯</Description>
    <Authors>qjatlr1111</Authors>
    <RepositoryUrl>https://github.com/qjatlr1111/codex-account-switcher</RepositoryUrl>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
</Project>
