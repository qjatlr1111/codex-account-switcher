<Window x:Class="ClaudeAccountWidget.SwitchConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClaudeAccountWidget.Controls"
        Title="계정 변경 확인"
        Width="350" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Opacity="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale">
    <Border Margin="10" Padding="18" CornerRadius="14" Background="#F71C1916"
            BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#66F3A27C" Offset="0"/>
                <GradientStop Color="#1CFFFFFF" Offset="0.5"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#FF0A0605"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <controls:SparkGlyph Width="16" Height="16" Fill="{StaticResource CoralGradientBrush}"
                                     VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="Claude 계정을 변경할까요?" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="Claude Code 인증이 선택한 계정으로 바뀝니다. 새로 여는 Claude Code 세션부터 적용됩니다."
                       Margin="0,6,0,14" FontSize="10.5" LineHeight="16"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

            <Border Padding="12,11" CornerRadius="10" Background="#1AF3A27C" BorderBrush="#3DF3A27C" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="변경할 계정" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding Profile.Email}" Margin="0,3,0,0"
                               FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="5시간" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                        <controls:UsageBar Grid.Column="1" Height="5" VerticalAlignment="Center"
                                           Target="{Binding Profile.PrimaryGauge}"
                                           FillBrush="{StaticResource BarGradientBrush}" LowBrush="{StaticResource LowGradientBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Profile.PrimaryPercentText}" FontSize="10.5" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="2" Text="주간" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                        <controls:UsageBar Grid.Row="2" Grid.Column="1" Height="5" VerticalAlignment="Center"
                                           Target="{Binding Profile.SecondaryGauge}"
                                           FillBrush="{StaticResource BarGradientBrush}" LowBrush="{StaticResource LowGradientBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Profile.SecondaryPercentText}" FontSize="10.5"
                                   HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 실행 중인 CLI 세션이 있을 때만 표시 -->
            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="10" Background="#14FF6B6B"
                    BorderBrush="#40FF8A80" BorderThickness="1"
                    Visibility="{Binding HasRunningSessions, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <CheckBox x:Name="StopSessionsCheckBox" IsChecked="True" Foreground="White" Cursor="Hand">
                        <TextBlock FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap">
                            <Run Text="실행 중인 Claude Code 세션"/>
                            <Run Text="{Binding RunningSessions, Mode=OneWay}"/><Run Text="개 종료 (권장)"/>
                        </TextBlock>
                    </CheckBox>
                    <TextBlock Margin="20,5,0,0" FontSize="9.5" LineHeight="14" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="켜 둔 세션이 토큰을 갱신하면 이전 계정으로 되돌아갈 수 있습니다. 종료한 세션은 같은 폴더에서 claude --continue 로 이어갈 수 있습니다."/>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <Button Content="취소" Height="38" Style="{StaticResource FlatButton}"
                        IsCancel="True" Click="OnCancelClicked"/>
                <Button Grid.Column="2" Content="이 계정으로 변경" Height="38"
                        Style="{StaticResource AccentButton}" IsDefault="True"
                        Click="OnConfirmClicked"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
