<Window x:Class="ClaudeAccountWidget.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClaudeAccountWidget.Controls"
        Title="Claude 계정 위젯"
        Width="236" Height="44"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <SolidColorBrush x:Key="WidgetPrimaryTextBrush" Color="#FFF7F1EC"/>
        <SolidColorBrush x:Key="WidgetSecondaryTextBrush" Color="#FFB1A79E"/>
        <LinearGradientBrush x:Key="WidgetHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#34FFE2D2" Offset="0"/>
            <GradientStop Color="#1EFFFFFF" Offset="0.5"/>
            <GradientStop Color="#14F3A27C" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WidgetPrimaryTextBrush}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="RootBorder" Background="#01000000"
                BorderThickness="0" CornerRadius="9"
                Cursor="Hand" MouseLeftButtonUp="OnOverlayClicked"
                MouseRightButtonUp="OnOverlayRightClicked"
                ToolTipService.InitialShowDelay="650" ToolTipService.Placement="Top">
            <Border.ToolTip>
                <ToolTip Background="#F21C1916" BorderBrush="#40F3A27C" Foreground="White" Padding="10,8">
                    <StackPanel MinWidth="170">
                        <TextBlock Text="{Binding ActiveProfile.Email, FallbackValue=Claude 계정, TargetNullValue=Claude 계정}"
                                   FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock Margin="0,4,0,0" FontSize="10.5">
                            <Run Text="{Binding ActiveProfile.PrimaryText, Mode=OneWay}"/>
                            <Run Text="  초기화 " Foreground="#FFB1A79E"/><Run Text="{Binding ActiveProfile.PrimaryResetText, Mode=OneWay}" Foreground="#FFB1A79E"/>
                        </TextBlock>
                        <TextBlock FontSize="10.5">
                            <Run Text="{Binding ActiveProfile.SecondaryText, Mode=OneWay}"/>
                            <Run Text="  초기화 " Foreground="#FFB1A79E"/><Run Text="{Binding ActiveProfile.SecondaryResetText, Mode=OneWay}" Foreground="#FFB1A79E"/>
                        </TextBlock>
                        <TextBlock Text="{Binding ActiveProfile.ExtraUsageText}" FontSize="10" Foreground="#FFB1A79E" Margin="0,2,0,0"/>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SparkRotate" Storyboard.TargetProperty="Angle"
                                             By="72" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.18" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.18" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                             To="0.9" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Border x:Name="HoverSurface" Background="{StaticResource WidgetHoverBrush}"
                        BorderBrush="#22FFFFFF" BorderThickness="1"
                        CornerRadius="9" Opacity="0" IsHitTestVisible="False"/>

                <Grid Margin="8,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 링 게이지 + 스파크 아이콘 -->
                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <Ellipse x:Name="HoverGlow" Margin="-6" Fill="{StaticResource WarmGlowBrush}"
                                 Opacity="0" IsHitTestVisible="False"/>
                        <Ellipse Margin="-7" Fill="{StaticResource WarmGlowBrush}" IsHitTestVisible="False">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile.IsLow}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="LowPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.15" To="1" Duration="0:0:1.1">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="LowPulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <controls:ArcGauge x:Name="PrimaryGauge"
                                           Target="{Binding ActiveProfile.PrimaryGauge, FallbackValue=-1, TargetNullValue=-1}"
                                           StrokeThickness="2.6"
                                           TrackBrush="#30FFFFFF"
                                           FillBrush="{StaticResource CoralGradientBrush}"
                                           LowBrush="{StaticResource LowGradientBrush}"/>
                        <controls:SparkGlyph Width="13" Height="13" Fill="{StaticResource CoralGradientBrush}"
                                             RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <controls:SparkGlyph.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SparkScale"/>
                                    <RotateTransform x:Name="SparkRotate"/>
                                </TransformGroup>
                            </controls:SparkGlyph.RenderTransform>
                        </controls:SparkGlyph>
                    </Grid>

                    <!-- 활성 계정이 있을 때 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                Visibility="{Binding HasActiveProfile, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ActiveProfile.Email}" FontSize="11.5"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ActiveProfile.PlanLabel}" FontSize="9.5"
                                   Foreground="{DynamicResource WidgetSecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Visibility="{Binding HasActiveProfile, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ActiveProfile.PrimaryText}" FontSize="10.5" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding ActiveProfile.SecondaryText}" FontSize="9.5" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource WidgetSecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- 활성 계정이 없을 때 -->
                    <StackPanel Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                Visibility="{Binding HasNoActiveProfile, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Claude 계정" FontSize="11.5" FontWeight="SemiBold"/>
                        <TextBlock Text="눌러서 계정 등록·전환" FontSize="9.5"
                                   Foreground="{DynamicResource WidgetSecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
