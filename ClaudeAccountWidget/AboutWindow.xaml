<Window x:Class="ClaudeAccountWidget.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClaudeAccountWidget.Controls"
        Title="Claude 계정 전환 위젯 정보"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Opacity="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="Grayscale">
    <Border Margin="10" Padding="20" CornerRadius="14" Background="#F71C1916"
            BorderBrush="#40F3A27C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#FF0A0605"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <controls:SparkGlyph Width="20" Height="20" Fill="{StaticResource CoralGradientBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Claude 계정 전환 위젯" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Margin="30,3,0,14" FontSize="10.5"
                       Foreground="{StaticResource MutedBrush}"/>

            <TextBlock Text="작업 표시줄에서 Claude 계정의 5시간·주간 사용량을 확인하고, 등록한 계정으로 Claude Code 로그인을 전환하는 Windows 위젯입니다."
                       FontSize="11" TextWrapping="Wrap" LineHeight="17"/>

            <Border Margin="0,14,0,0" Padding="12" CornerRadius="10" Background="#14FFFFFF">
                <StackPanel>
                    <TextBlock Text="보안 안내" FontSize="10.5" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap" LineHeight="15"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Anthropic의 공식 제품이 아닌 커뮤니티 도구입니다. 계정별 로그인 정보(.credentials.json)가 로컬 디스크에 저장되므로 공유 PC에서는 사용하지 마세요."/>
                </StackPanel>
            </Border>

            <Button Content="GitHub 릴리스 열기" Height="36" Margin="0,16,0,0"
                    Style="{StaticResource FlatButton}" Click="OnGitHubClicked"/>
            <Button Content="닫기" Height="36" Margin="0,8,0,0"
                    Style="{StaticResource AccentButton}" Click="OnCloseClicked"/>
        </StackPanel>
    </Border>
</Window>
